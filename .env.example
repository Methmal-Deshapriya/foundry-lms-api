PORT=5000

DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=your_accelerate_api_key"
DIRECT_DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

JWT_SECRET="your_jwt_secret_key"
JWT_EXPIRES_IN="1d"

# Password reset email (Gmail SMTP via Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASSWORD="your_16_char_app_password"
SMTP_FROM_EMAIL="Foundry Academy <your_email@gmail.com>"

# Base URL of the frontend app, used to build links inside emails
CLIENT_URL="http://localhost:3000"
