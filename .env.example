PORT=5000
# Set to production on the live server (the host usually sets it). Production
# turns on the strict startup checks in src/config/runtimeConfig.js.
# NODE_ENV=production

# Optional public origin used inside URL-imported Postman artifacts. When empty,
# the API derives it from the incoming request (for example http://localhost:5000).
PUBLIC_API_URL=""

DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=your_accelerate_api_key"
DIRECT_DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"
# Optional direct-mode schema override for isolated migration/integration tests.
DATABASE_SCHEMA=""

JWT_SECRET="your_jwt_secret_key"
JWT_EXPIRES_IN="1d"
JWT_ISSUER="foundry-lms-api"
JWT_AUDIENCE="foundry-lms-client"
API_INSTANCE_COUNT=1
# Required when API_INSTANCE_COUNT is greater than 1 in production.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS=2000
DB_STATEMENT_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000
DB_IDLE_TRANSACTION_TIMEOUT_MS=30000
# Prisma interactive transactions fail before PostgreSQL's idle-transaction
# deadline. Increase both together if a high-latency deployment requires it.
DB_INTERACTIVE_TRANSACTION_TIMEOUT_MS=15000
DB_INTERACTIVE_TRANSACTION_MAX_WAIT_MS=5000
# Required for Accelerate production after the database role has non-zero
# statement_timeout and idle_in_transaction_session_timeout defaults.
DB_TIMEOUTS_MANAGED_EXTERNALLY=false
DB_APPLICATION_ROLE="prisma_application"
PROJECT_THUMBNAIL_HOSTS="cdn.example.com"

# Transactional email (Resend) — plain HTTPS API, not SMTP, since Render's
# free tier blocks outbound SMTP ports. RESEND_FROM_EMAIL's domain must be
# verified in the Resend dashboard first.
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="Foundry Academy <noreply@yourdomain.com>"
EMAIL_READINESS_CACHE_MS=60000
# Resend plan limits, used to keep bulk notification email from using up the
# quota that sign-in codes and password resets need. Defaults: free plan.
# EMAIL_DAILY_LIMIT=100
# EMAIL_MONTHLY_LIMIT=3000
# Pause between payment-reminder emails (Resend rate-limits bursts).
# NOTIFICATION_EMAIL_INTERVAL_MS=400
READINESS_CHECK_EMAIL=false

# First key signs new short codes; keep prior versions during rotation.
OTP_HMAC_KEYS="v1:replace-with-at-least-32-random-bytes"
AUTH_ARTIFACT_RETENTION_DAYS=7
AUTH_ARTIFACT_CLEANUP_BATCH_SIZE=500
AUTH_ARTIFACT_CLEANUP_INTERVAL_MS=3600000

# Base URL of the frontend app, used to build links inside emails
CLIENT_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Number of reverse proxies in production. Keep 0 for direct local requests.
# Number of proxies in front of the API (Render = 1, +1 if Cloudflare proxies
# in front). Required in production; 0 there also needs TRUST_PROXY_DIRECT=true.
TRUST_PROXY_HOPS=0
# Only when the production API is reached directly, with no proxy in front:
# TRUST_PROXY_DIRECT=true
# Auth cookie SameSite: lax (default; needs the site and API on one domain,
# e.g. foundryacademy.lk + api.foundryacademy.lk) or none (API on another
# domain; production/HTTPS only).
# AUTH_COOKIE_SAME_SITE=lax
# Never-verified student sign-ups are deleted after this many days.
# UNVERIFIED_ACCOUNT_RETENTION_DAYS=30

# Must match the server-only value configured in the Next.js frontend.
CATALOG_REVALIDATION_SECRET="generate-a-long-random-secret"

# Cloudflare R2 object storage. Keep these values server-only. Two buckets are
# intentional: public catalog imagery and private enrollment-protected files.
R2_ENABLED=false
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BUCKET="foundry-lms-public"
R2_PRIVATE_BUCKET="foundry-lms-private"
R2_PUBLIC_BASE_URL="https://assets.example.com"
R2_UPLOAD_URL_TTL_SECONDS=300
R2_DOWNLOAD_URL_TTL_SECONDS=300
R2_READINESS_CACHE_MS=60000
R2_MAX_IMAGE_BYTES=10485760
# Shared secret for the daily storage-cleanup GitHub Action
# (.github/workflows/storage-cleanup.yml). Leave empty to disable that route.
STORAGE_CLEANUP_SECRET=""
R2_MAX_MATERIAL_BYTES=104857600
R2_MAX_RECORDING_BYTES=5368709120
R2_MAX_PROJECT_THUMBNAIL_BYTES=5242880

# One-time development bootstrap. Keep real values only in .env, then run:
# npm run bootstrap:super-admin
BOOTSTRAP_SUPER_ADMIN_EMAIL=""
BOOTSTRAP_SUPER_ADMIN_PASSWORD=""
BOOTSTRAP_SUPER_ADMIN_FIRST_NAME="Foundry"
BOOTSTRAP_SUPER_ADMIN_LAST_NAME="Administrator"
