# Copy to /opt/foundry-lms/env/deploy.env on the VPS and chmod it to 600.
# APP_TAG must identify the exact web/API images loaded for one release. A Git
# commit SHA is ideal. Never use "latest" because it makes rollback ambiguous.
APP_TAG=replace-with-git-commit-sha
FOUNDRY_ENV_DIR=/opt/foundry-lms/env
POSTGRES_VOLUME_NAME=foundry-lms-postgres-data
