# Copy to /opt/foundry-lms/env/api.env on the VPS and chmod it to 600.
# This is a template only. Never commit the completed production file.

NODE_ENV=production
PORT=5000

# Use exactly the same URL-safe password as POSTGRES_PASSWORD in db.env.
DATABASE_URL=postgresql://foundry_app:replace-with-a-random-hex-password@db:5432/foundry_lms
DIRECT_DATABASE_URL=postgresql://foundry_app:replace-with-a-random-hex-password@db:5432/foundry_lms

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=1d
JWT_ISSUER=foundry-lms-api
JWT_AUDIENCE=foundry-lms-client
OTP_HMAC_KEYS=v1:replace-with-at-least-32-random-bytes

API_INSTANCE_COUNT=1
DB_STATEMENT_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000
DB_IDLE_TRANSACTION_TIMEOUT_MS=30000
DB_INTERACTIVE_TRANSACTION_TIMEOUT_MS=15000
DB_INTERACTIVE_TRANSACTION_MAX_WAIT_MS=5000
DB_TIMEOUTS_MANAGED_EXTERNALLY=false

CLIENT_URL=https://foundryacademy.lk
CORS_ORIGIN=https://foundryacademy.lk,https://www.foundryacademy.lk
PUBLIC_API_URL=https://api.foundryacademy.lk
# cloudflared is the one proxy directly in front of the API container.
TRUST_PROXY_HOPS=1
AUTH_COOKIE_SAME_SITE=lax

RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL="Foundry Academy <noreply@foundryacademy.lk>"
EMAIL_READINESS_CACHE_MS=60000
READINESS_CHECK_EMAIL=false

AUTH_ARTIFACT_RETENTION_DAYS=7
AUTH_ARTIFACT_CLEANUP_BATCH_SIZE=500
AUTH_ARTIFACT_CLEANUP_INTERVAL_MS=3600000
UNVERIFIED_ACCOUNT_RETENTION_DAYS=30

# Must exactly match CATALOG_REVALIDATION_SECRET in web.env.
CATALOG_REVALIDATION_SECRET=replace-with-at-least-32-random-bytes

# Replace these values with the Cloudflare R2 configuration prepared for the
# two-bucket public/private storage design.
R2_ENABLED=true
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_PUBLIC_BUCKET=foundry-lms-public
R2_PRIVATE_BUCKET=foundry-lms-private
R2_PUBLIC_BASE_URL=https://assets.foundryacademy.lk
R2_UPLOAD_URL_TTL_SECONDS=300
R2_DOWNLOAD_URL_TTL_SECONDS=300
R2_READINESS_CACHE_MS=60000
R2_MAX_IMAGE_BYTES=10485760
R2_MAX_MATERIAL_BYTES=104857600
R2_MAX_RECORDING_BYTES=5368709120
R2_MAX_PROJECT_THUMBNAIL_BYTES=5242880
STORAGE_CLEANUP_SECRET=replace-with-at-least-32-random-bytes

# Comma-separated hostnames only, without https://.
PROJECT_THUMBNAIL_HOSTS=assets.foundryacademy.lk
