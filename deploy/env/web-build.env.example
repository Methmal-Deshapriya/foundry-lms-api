# Copy to /opt/foundry-lms/env/web-build.env on the server.
# Public (non-secret) values compiled into the website during the image build
# on the server (deploy/scripts/build-release-on-server.sh). They are visible
# in the browser by design. Change one, then build a new release.

# The API's public address, including /api/v1.
NEXT_PUBLIC_API_BASE_URL=https://api.foundryacademy.lk/api/v1
# Where images load from: the R2 public bucket's address (api.env R2_PUBLIC_BASE_URL).
NEXT_PUBLIC_IMAGE_ORIGINS=https://assets.foundryacademy.lk
# The Cloudflare account id (same as R2_ACCOUNT_ID in api.env). Not a secret.
NEXT_PUBLIC_R2_ACCOUNT_ID=replace-with-cloudflare-account-id
