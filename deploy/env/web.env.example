# Copy to /opt/foundry-lms/env/web.env on the VPS and chmod it to 600.
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Must exactly match CATALOG_REVALIDATION_SECRET in api.env.
CATALOG_REVALIDATION_SECRET=replace-with-at-least-32-random-bytes

# NEXT_PUBLIC_* values are intentionally absent. They are compiled into the
# web image at build time; see the runbook's image-build command.

