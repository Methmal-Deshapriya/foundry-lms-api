// Foundry LMS database schema (Prisma 7 / PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
  SUPER_ADMIN
}

enum LearningAccessType {
  FREE
  PAID
}

enum LearningCourseMode {
  SEASONAL
  EVERGREEN
}

enum LearningEnrollmentMode {
  ADMIN
  SELF
}

enum LearningPaymentRequirement {
  REQUIRED
  NOT_REQUIRED
}

enum LearningServiceStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CatalogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseLevel {
  OPEN
  FOUNDATION
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum DurationUnit {
  SESSION
  DAY
  WEEK
  MONTH
}

enum SessionStatus {
  DRAFT
  READY
  ARCHIVED
}

enum CourseStatus {
  DRAFT
  OPEN_ACTIVE
  CLOSED_ACTIVE
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum CourseSessionDeliveryStatus {
  UNRELEASED
  SCHEDULED
  RELEASED
  WITHDRAWN
}

enum EnrollmentSource {
  ADMIN
  SELF
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PARTIAL
  COMPLETED
}

enum CertificateStatus {
  ISSUED
  REVOKED
}

enum ProjectStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String    @id @default(uuid())
  firstName       String    @default("") @map("first_name")
  lastName        String    @default("") @map("last_name")
  email           String    @unique
  phone           String?
  address         String?
  district        String?
  dateOfBirth     DateTime? @map("date_of_birth")
  alStream        String?   @map("al_stream")
  password        String
  role            Role      @default(STUDENT)
  emailVerified   Boolean   @default(false) @map("email_verified")
  securityVersion Int       @default(0) @map("security_version")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  enrollments         Enrollment[]         @relation("StudentEnrollments")
  managedEnrollments  Enrollment[]         @relation("EnrollmentManager")
  studentProjects     StudentProject[]
  actorAuditLogs      AuditLog[]           @relation("ActorRelation")
  passwordResetTokens PasswordResetToken[]
  emailOtps           EmailOtp[]
  loginChallenges     LoginChallenge[]

  @@index([role, emailVerified, email, id])
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_first_name_trgm_idx")
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_last_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "users_email_trgm_idx")
  @@map("users")
}

model LoginChallenge {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  attempts  Int       @default(0)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("login_challenges")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailOtp {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_otps")
}

model LearningService {
  id                 String                     @id @default(uuid())
  key                String                     @unique
  slug               String                     @unique
  title              String
  description        String
  accessType         LearningAccessType         @map("access_type")
  courseMode         LearningCourseMode         @map("course_mode")
  enrollmentMode     LearningEnrollmentMode     @map("enrollment_mode")
  paymentRequirement LearningPaymentRequirement @map("payment_requirement")
  status             LearningServiceStatus      @default(DRAFT)
  sortOrder          Int                        @default(0) @map("sort_order")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @default(now()) @updatedAt @map("updated_at")

  categories Category[]

  @@index([status, sortOrder, title])
  @@map("learning_services")
}

model Category {
  id            String        @id @default(uuid())
  serviceId     String        @map("service_id")
  slug          String
  title         String
  description   String
  audienceLabel String?       @map("audience_label")
  visualKey     String        @map("visual_key")
  badgeLabel    String?       @map("badge_label")
  status        CatalogStatus @default(DRAFT)
  sortOrder     Int           @default(0) @map("sort_order")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at")

  courseGroups CourseGroup[]
  courses      Course[]
  service      LearningService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([serviceId, slug])
  @@index([serviceId, status, sortOrder])
  @@map("categories")
}

model CourseGroup {
  id                 String    @id @default(uuid())
  categoryId         String    @map("category_id")
  slug               String
  title              String
  batchCodePrefix    String    @unique @map("batch_code_prefix")
  certificateEnabled Boolean   @map("certificate_enabled")
  archivedAt         DateTime? @map("archived_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  courses  Course[]

  @@unique([id, categoryId])
  @@unique([categoryId, slug])
  @@index([categoryId, archivedAt, title])
  @@map("course_groups")
}

model Course {
  id              String        @id @default(uuid())
  courseGroupId   String        @map("course_group_id")
  categoryId      String        @map("category_id")
  slug            String
  title           String
  summary         String
  description     String
  level           CourseLevel
  durationValue   Int?          @map("duration_value")
  durationUnit    DurationUnit? @map("duration_unit")
  highlights      String[]      @default([])
  skills          String[]      @default([])
  prerequisites   String[]      @default([])
  thumbnailUrl    String?       @map("thumbnail_url")
  sortOrder       Int           @default(0) @map("sort_order")
  intakeKey       String        @map("intake_key")
  code            String        @unique
  startDate       DateTime?     @map("start_date") @db.Date
  expectedEndDate DateTime?     @map("expected_end_date") @db.Date
  timezone        String        @default("Asia/Colombo")
  capacity        Int?
  price           Decimal       @default(0) @db.Decimal(12, 2)
  currency        String        @default("LKR")
  status          CourseStatus  @default(DRAFT)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at")

  courseGroup     CourseGroup      @relation(fields: [courseGroupId, categoryId], references: [id, categoryId], onDelete: Restrict)
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  enrollments     Enrollment[]
  courseSessions  CourseSession[]
  studentProjects StudentProject[]

  @@unique([courseGroupId, intakeKey])
  @@index([courseGroupId, status, startDate])
  @@index([categoryId, status, sortOrder])
  @@index([categoryId, status, slug])
  @@map("courses")
}

model Enrollment {
  id                       String           @id @default(uuid())
  userId                   String           @map("user_id")
  courseId                 String           @map("course_id")
  source                   EnrollmentSource
  enrolledByUserId         String?          @map("enrolled_by_user_id")
  status                   EnrollmentStatus @default(ACTIVE)
  paymentStatus            PaymentStatus    @default(PENDING) @map("payment_status")
  paymentCompletedAt       DateTime?        @map("payment_completed_at")
  externalPaymentReference String?          @map("external_payment_reference")
  paymentNote              String?          @map("payment_note")
  completedAt              DateTime?        @map("completed_at")
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @default(now()) @updatedAt @map("updated_at")

  user               User                @relation("StudentEnrollments", fields: [userId], references: [id], onDelete: Cascade)
  enrolledBy         User?               @relation("EnrollmentManager", fields: [enrolledByUserId], references: [id], onDelete: SetNull)
  course             Course              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  sessionCompletions SessionCompletion[]
  certificates       Certificate[]
  studentProjects    StudentProject[]

  @@unique([id, courseId])
  @@unique([userId, courseId])
  @@index([userId, status])
  @@index([courseId, status])
  @@index([courseId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([enrolledByUserId])
  @@map("enrollments")
}

model Session {
  id              String        @id @default(uuid())
  title           String
  description     String?
  recordingUrl    String?       @map("recording_url")
  materialUrl     String?       @map("material_url")
  quizUrl         String?       @map("quiz_url")
  feedbackUrl     String?       @map("feedback_url")
  durationMinutes Int?          @map("duration_minutes")
  status          SessionStatus @default(DRAFT)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at")

  courseSessions CourseSession[]

  @@index([status, updatedAt(sort: Desc)])
  @@map("sessions")
}

model CourseSession {
  id                   String                      @id @default(uuid())
  courseId             String                      @map("course_id")
  sessionId            String                      @map("session_id")
  orderIndex           Int?                        @map("order_index")
  deliveryStatus       CourseSessionDeliveryStatus @default(UNRELEASED) @map("delivery_status")
  availableAt          DateTime?                   @map("available_at")
  firstReleasedAt      DateTime?                   @map("first_released_at")
  retiredAt            DateTime?                   @map("retired_at")
  historicalOrderIndex Int?                        @map("historical_order_index")
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @default(now()) @updatedAt @map("updated_at")

  course      Course              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  session     Session             @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  completions SessionCompletion[]

  @@unique([id, courseId])
  @@unique([courseId, sessionId])
  @@unique([courseId, orderIndex])
  @@index([sessionId])
  @@index([courseId, retiredAt, orderIndex])
  @@index([courseId, deliveryStatus, availableAt])
  @@map("course_sessions")
}

model SessionCompletion {
  id              String   @id @default(uuid())
  courseSessionId String   @map("course_session_id")
  enrollmentId    String   @map("enrollment_id")
  courseId        String   @map("course_id")
  completedAt     DateTime @default(now()) @map("completed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  courseSession CourseSession @relation(fields: [courseSessionId, courseId], references: [id, courseId], onDelete: Cascade)
  enrollment    Enrollment    @relation(fields: [enrollmentId, courseId], references: [id, courseId], onDelete: Cascade)

  @@unique([courseSessionId, enrollmentId])
  @@index([enrollmentId])
  @@index([courseSessionId])
  @@index([courseId])
  @@map("session_completions")
}

model Certificate {
  id               String            @id @default(uuid())
  enrollmentId     String            @map("enrollment_id")
  certificateCode  String            @unique @map("certificate_code")
  studentName      String            @map("student_name")
  courseName       String            @map("course_name")
  description      String?
  issuedDate       DateTime          @map("issued_date")
  status           CertificateStatus @default(ISSUED)
  revokedAt        DateTime?         @map("revoked_at")
  revokedBy        String?           @map("revoked_by")
  revocationReason String?           @map("revocation_reason")
  certificateData  Json              @map("certificate_data")
  snapshotUrl      String?           @map("snapshot_url")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, status, issuedDate(sort: Desc)])
  @@index([status, issuedDate])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([certificateCode(ops: raw("gin_trgm_ops"))], type: Gin, map: "certificates_code_trgm_idx")
  @@index([studentName(ops: raw("gin_trgm_ops"))], type: Gin, map: "certificates_student_name_trgm_idx")
  @@index([courseName(ops: raw("gin_trgm_ops"))], type: Gin, map: "certificates_course_name_trgm_idx")
  @@map("certificates")
}

model StudentProject {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  courseId      String        @map("course_id")
  enrollmentId  String        @map("enrollment_id")
  title         String
  description   String?
  thumbnailUrl  String?       @map("thumbnail_url")
  projectUrl    String?       @map("project_url")
  githubUrl     String?       @map("github_url")
  demoUrl       String?       @map("demo_url")
  technologies  Json          @default("[]")
  status        ProjectStatus @default(PENDING)
  reviewedBy    String?       @map("reviewed_by")
  reviewedAt    DateTime?     @map("reviewed_at")
  adminFeedback String?       @map("admin_feedback")
  isPublic      Boolean       @default(false) @map("is_public")
  displayOrder  Int           @default(0) @map("display_order")
  likeCount     Int           @default(0) @map("like_count")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrollment Enrollment @relation(fields: [enrollmentId, courseId], references: [id, courseId], onDelete: Cascade)

  @@index([courseId, status, isPublic])
  @@index([userId, createdAt(sort: Desc)])
  @@index([enrollmentId])
  @@index([likeCount(sort: Desc), createdAt(sort: Desc)])
  @@map("student_projects")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  description String?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation("ActorRelation", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
