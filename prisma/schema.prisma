// This is your Prisma schema file (Modern Prisma 7 Edition)
// It defines the data shapes for Foundry LMS.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User Roles
enum Role {
  STUDENT
  ADMIN
  SUPER_ADMIN
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  COMPLETED
}

enum CertificateStatus {
  ISSUED
  REVOKED
}

enum ProjectStatus {
  PENDING
  APPROVED
  REJECTED
}

// User Model: Identity and System Authority
model User {
  id            String    @id @default(uuid())
  firstName     String    @default("") @map("first_name")
  lastName      String    @default("") @map("last_name")
  email         String    @unique
  phone         String?   @map("phone") // String to preserve leading zeros
  address       String?
  district      String?
  dateOfBirth   DateTime? @map("date_of_birth")
  alStream      String?   @map("al_stream")
  password      String
  role          Role      @default(STUDENT)
  emailVerified Boolean   @default(false) @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  // Relationships
  enrollments         Enrollment[]
  studentProjects     StudentProject[]
  actorAuditLogs      AuditLog[]           @relation("ActorRelation")
  passwordResetTokens PasswordResetToken[]
  emailOtps           EmailOtp[]

  @@map("users")
}

// PasswordResetToken Model: Short-lived tokens for the "forgot password" flow.
// Stores a hash of the token, never the raw value sent to the user's inbox.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// EmailOtp Model: One-time codes for verifying a newly registered email.
// Stores a hash of the code, never the raw value sent to the user's inbox.
model EmailOtp {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_otps")
}

// Bootcamp Model: The learning products
model Bootcamp {
  id                 String           @id @default(uuid())
  title              String
  slug               String           @unique
  description        String?
  price              Float
  isPublished        Boolean          @default(false) @map("is_published")
  certificateEnabled Boolean          @default(false) @map("certificate_enabled")
  skills             Json             @default("[]") // Array of strings
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at")

  // Relationships
  enrollments     Enrollment[]
  sessions        Session[]
  studentProjects StudentProject[]

  @@map("bootcamps")
}

// Enrollment Model: The "Bridge" linking Students to Bootcamps
model Enrollment {
  id                 String           @id @default(uuid())
  userId             String           @map("user_id")
  bootcampId         String           @map("bootcamp_id")
  status             EnrollmentStatus @default(ACTIVE)
  paymentStatus      PaymentStatus    @default(PENDING) @map("payment_status")
  paymentCompletedAt DateTime?        @map("payment_completed_at")
  completedAt        DateTime?        @map("completed_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at")

  // Relationships
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  bootcamp           Bootcamp            @relation(fields: [bootcampId], references: [id], onDelete: Cascade)
  sessionCompletions SessionCompletion[]
  certificate        Certificate?
  studentProjects    StudentProject[]

  @@unique([userId, bootcampId])
  @@map("enrollments")
}

model Session {
  id              String   @id @default(uuid())
  bootcampId      String   @map("bootcamp_id")
  title           String
  description     String?
  orderIndex      Int      @map("order_index")
  recordingUrl    String?  @map("recording_url")
  materialUrl     String?  @map("material_url")
  quizUrl         String?  @map("quiz_url")
  feedbackUrl     String?  @map("feedback_url")
  durationMinutes Int?     @map("duration_minutes")
  isPublished     Boolean  @default(false) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  // Relationships
  bootcamp    Bootcamp            @relation(fields: [bootcampId], references: [id], onDelete: Cascade)
  completions SessionCompletion[]

  @@unique([bootcampId, orderIndex])
  @@index([bootcampId, isPublished, orderIndex])
  @@map("sessions")
}

model SessionCompletion {
  id           String   @id @default(uuid())
  sessionId    String   @map("session_id")
  enrollmentId String   @map("enrollment_id")
  completedAt  DateTime @default(now()) @map("completed_at")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relationships
  session    Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, enrollmentId])
  @@index([enrollmentId])
  @@index([sessionId])
  @@map("session_completions")
}

model Certificate {
  id               String            @id @default(uuid())
  enrollmentId     String            @unique @map("enrollment_id")
  certificateCode  String            @unique @map("certificate_code")
  studentName      String            @map("student_name")
  bootcampName     String            @map("bootcamp_name")
  description      String?
  issuedDate       DateTime          @map("issued_date")
  status           CertificateStatus @default(ISSUED)
  revokedAt        DateTime?         @map("revoked_at")
  revokedBy        String?           @map("revoked_by")
  revocationReason String?           @map("revocation_reason")
  certificateData  Json              @map("certificate_data")
  snapshotUrl      String?           @map("snapshot_url")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at")

  // Relationships
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

model StudentProject {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  bootcampId    String        @map("bootcamp_id")
  enrollmentId  String        @map("enrollment_id")
  title         String
  description   String?
  thumbnailUrl  String?       @map("thumbnail_url")
  projectUrl    String?       @map("project_url")
  githubUrl     String?       @map("github_url")
  demoUrl       String?       @map("demo_url")
  technologies  Json          @default("[]")
  status        ProjectStatus @default(PENDING)
  reviewedBy    String?       @map("reviewed_by")
  reviewedAt    DateTime?     @map("reviewed_at")
  adminFeedback String?       @map("admin_feedback")
  isPublic      Boolean       @default(false) @map("is_public")
  displayOrder  Int           @default(0) @map("display_order")
  likeCount     Int           @default(0) @map("like_count")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at")

  // Relationships
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bootcamp   Bootcamp   @relation(fields: [bootcampId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([bootcampId, status, isPublic])
  @@index([userId, createdAt(sort: Desc)])
  @@index([likeCount(sort: Desc), createdAt(sort: Desc)])
  @@map("student_projects")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  description String?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relationships
  actor User? @relation("ActorRelation", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
