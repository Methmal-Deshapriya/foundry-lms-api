// Foundry LMS database schema (Prisma 7 / PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
  SUPER_ADMIN
}

enum LearningServiceType {
  BOOTCAMPS
  PRETECH
  FREE_LEARNING
}

enum CatalogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseLevel {
  OPEN
  FOUNDATION
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum DurationUnit {
  SESSION
  DAY
  WEEK
  MONTH
}

enum CourseAccessType {
  FREE
  PAID
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PARTIAL
  COMPLETED
}

enum CertificateStatus {
  ISSUED
  REVOKED
}

enum ProjectStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(uuid())
  firstName     String    @default("") @map("first_name")
  lastName      String    @default("") @map("last_name")
  email         String    @unique
  phone         String?
  address       String?
  district      String?
  dateOfBirth   DateTime? @map("date_of_birth")
  alStream      String?   @map("al_stream")
  password      String
  role          Role      @default(STUDENT)
  emailVerified Boolean   @default(false) @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  enrollments         Enrollment[]
  studentProjects     StudentProject[]
  actorAuditLogs      AuditLog[]           @relation("ActorRelation")
  passwordResetTokens PasswordResetToken[]
  emailOtps           EmailOtp[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailOtp {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_otps")
}

model Category {
  id            String              @id @default(uuid())
  serviceType   LearningServiceType @map("service_type")
  slug          String
  title         String
  description   String
  audienceLabel String?             @map("audience_label")
  visualKey     String              @map("visual_key")
  badgeLabel    String?             @map("badge_label")
  status        CatalogStatus       @default(DRAFT)
  sortOrder     Int                 @default(0) @map("sort_order")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at")

  courses Course[]

  @@unique([serviceType, slug])
  @@index([serviceType, status, sortOrder])
  @@map("categories")
}

model Course {
  id                 String           @id @default(uuid())
  categoryId         String           @map("category_id")
  slug               String
  title              String
  summary            String
  description        String
  level              CourseLevel
  durationValue      Int?             @map("duration_value")
  durationUnit       DurationUnit?    @map("duration_unit")
  accessType         CourseAccessType @map("access_type")
  price              Decimal          @default(0) @db.Decimal(12, 2)
  currency           String           @default("LKR")
  certificateEnabled Boolean          @default(false) @map("certificate_enabled")
  highlights         String[]         @default([])
  skills             String[]         @default([])
  prerequisites      String[]         @default([])
  thumbnailUrl       String?          @map("thumbnail_url")
  status             CatalogStatus    @default(DRAFT)
  sortOrder          Int              @default(0) @map("sort_order")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at")

  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  enrollments     Enrollment[]
  sessions        Session[]
  studentProjects StudentProject[]

  @@unique([categoryId, slug])
  @@index([categoryId, status, sortOrder])
  @@map("courses")
}

model Enrollment {
  id                 String           @id @default(uuid())
  userId             String           @map("user_id")
  courseId           String           @map("course_id")
  status             EnrollmentStatus @default(ACTIVE)
  paymentStatus      PaymentStatus    @default(PENDING) @map("payment_status")
  paymentCompletedAt DateTime?        @map("payment_completed_at")
  completedAt        DateTime?        @map("completed_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  course             Course              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  sessionCompletions SessionCompletion[]
  certificate        Certificate?
  studentProjects    StudentProject[]

  @@unique([userId, courseId])
  @@index([courseId, status])
  @@map("enrollments")
}

model Session {
  id              String   @id @default(uuid())
  courseId        String   @map("course_id")
  title           String
  description     String?
  orderIndex      Int      @map("order_index")
  recordingUrl    String?  @map("recording_url")
  materialUrl     String?  @map("material_url")
  quizUrl         String?  @map("quiz_url")
  feedbackUrl     String?  @map("feedback_url")
  durationMinutes Int?     @map("duration_minutes")
  isPublished     Boolean  @default(false) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  course      Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completions SessionCompletion[]

  @@unique([courseId, orderIndex])
  @@index([courseId, isPublished, orderIndex])
  @@map("sessions")
}

model SessionCompletion {
  id           String   @id @default(uuid())
  sessionId    String   @map("session_id")
  enrollmentId String   @map("enrollment_id")
  completedAt  DateTime @default(now()) @map("completed_at")
  createdAt    DateTime @default(now()) @map("created_at")

  session    Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, enrollmentId])
  @@index([enrollmentId])
  @@index([sessionId])
  @@map("session_completions")
}

model Certificate {
  id               String            @id @default(uuid())
  enrollmentId     String            @unique @map("enrollment_id")
  certificateCode  String            @unique @map("certificate_code")
  studentName      String            @map("student_name")
  courseName       String            @map("course_name")
  description      String?
  issuedDate       DateTime          @map("issued_date")
  status           CertificateStatus @default(ISSUED)
  revokedAt        DateTime?         @map("revoked_at")
  revokedBy        String?           @map("revoked_by")
  revocationReason String?           @map("revocation_reason")
  certificateData  Json              @map("certificate_data")
  snapshotUrl      String?           @map("snapshot_url")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([status, issuedDate])
  @@map("certificates")
}

model StudentProject {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  courseId      String        @map("course_id")
  enrollmentId  String        @map("enrollment_id")
  title         String
  description   String?
  thumbnailUrl  String?       @map("thumbnail_url")
  projectUrl    String?       @map("project_url")
  githubUrl     String?       @map("github_url")
  demoUrl       String?       @map("demo_url")
  technologies  Json          @default("[]")
  status        ProjectStatus @default(PENDING)
  reviewedBy    String?       @map("reviewed_by")
  reviewedAt    DateTime?     @map("reviewed_at")
  adminFeedback String?       @map("admin_feedback")
  isPublic      Boolean       @default(false) @map("is_public")
  displayOrder  Int           @default(0) @map("display_order")
  likeCount     Int           @default(0) @map("like_count")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([courseId, status, isPublic])
  @@index([userId, createdAt(sort: Desc)])
  @@index([likeCount(sort: Desc), createdAt(sort: Desc)])
  @@map("student_projects")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  description String?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation("ActorRelation", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
