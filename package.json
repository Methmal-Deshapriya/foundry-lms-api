{
  "name": "foundry-lms-server",
  "version": "1.0.0",
  "description": "Express and Prisma API for the Foundry Academy LMS",
  "main": "src/index.js",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:pipeline": "vitest run src/integration/learningDelivery.pipeline.integration.test.js",
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "studio": "prisma studio",
    "seed": "prisma db seed",
    "bootstrap:super-admin": "node prisma/bootstrap-super-admin.js",
    "api:postman": "node scripts/check-api-contract.js && node scripts/generate-postman.js",
    "api:contract:check": "node scripts/check-api-contract.js",
    "api:artifacts:check": "node scripts/check-api-contract.js && node scripts/generate-postman.js --check"
  },
  "keywords": [
    "lms",
    "express",
    "prisma"
  ],
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/extension-accelerate": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.3",
    "pg": "^8.23.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "vitest": "^4.1.7",
    "yaml": "^2.9.0"
  }
}
